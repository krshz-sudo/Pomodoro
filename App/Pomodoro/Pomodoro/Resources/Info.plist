<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Live Activities / Dynamic Island support -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- Optional but recommended: allow the Live Activity to be updated
         frequently while the app is active. -->
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>

    <!-- Background mode so timer state can be reconciled if the app briefly
         wakes in the background (the engine itself is Date-based, so this is
         a convenience, not a requirement for accuracy). -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Standard app metadata — merge with whatever Xcode generates -->
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
</dict>
</plist>
